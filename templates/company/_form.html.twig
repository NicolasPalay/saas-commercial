

{{ form_start(form) }}

       <label class="btn-ocean-sm label-image mb-4">
          📷 
          {{ form_widget(form.urlLogo, {
              attr: {
                  class: 'd-none',
                  onchange: 'this.nextElementSibling.innerText = this.files[0]?.name || "Choisir une image de logo"'
              }
          }) }}
          <span class="ms-2">Choisir une image pour votre logo</span>
      </label>
      {{ form_row(form.name) }}
      {{ form_row(form.street) }}
      {{ form_row(form.street2) }}
      <div class="d-flex gap-3 col-md-6 justify-between">
        {{ form_row(form.codePostal) }}
        {{ form_row(form.ville) }}

      </div>

      {{ form_row(form.siret) }}
      {{ form_row(form.tvaIntra) }}
      {{ form_row(form.iban) }}

<div class="divider"></div>
    {{ form_row(form.refDevis) }}
    {{ form_row(form.refOrder) }}
    {{ form_row(form.refFacture) }}
    
    <button class="btn-ocean btn-ocean-primary mt-2">{{ button_label|default('Enregistrer') }}</button>
{{ form_end(form) }}
