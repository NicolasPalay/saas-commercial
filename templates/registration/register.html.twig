{% extends 'base.html.twig' %}

{% block title %}Créer un compte{% endblock %}

{% block body %}
<main class="d-flex w-75 ">

<div class="w-100 mx-4">

     

    <div class="login-card">
        
        <div class="login-header">
            <div class="d-flex justify-content-center mb-2"><a href="{{ path('app_home') }}"><img class="logo" src="{{asset('images/logo.png')}}" alt=""></a></div>
                 <h1><i class="bi bi-box-seam"></i> Nouveau produit</h1>

            </div>

            <div class="login-body">
                <section>
        {{ form_start(registrationForm) }}
          {{ form_row(registrationForm.email) }}
          <div class="d-flex gap-3 col-md-6 justify-between">
            {{ form_row(registrationForm.firstname) }}
            {{ form_row(registrationForm.lastname) }}
          </div>
          {{ form_row(registrationForm.plainPassword) }}
          {{ form_row(registrationForm.name) }}
          {{ form_row(registrationForm.refDevis) }}
          {{ form_row(registrationForm.refOrder) }}
          {{ form_row(registrationForm.refFacture) }}
          <div class="col-md-6">
            <div class="form-check form-switch">
                {{ form_widget(registrationForm.agreeTerms, { attr: { class: 'form-check-input' } }) }}
                {{ form_label(registrationForm.agreeTerms, 'Accepter les conditions', { label_attr: { class: 'form-check-label' } }) }}
            </div>
        </div>
  

            <button class="btn-submit mt-5" type="submit">Envoyer</button>
        {{ form_end(registrationForm) }}
     </section>
            </div>    
        </div>
    </div>

  </div>
</div>


</div>    
</main>
<script>
function togglePassword() {
  const passwordInput = document.getElementById('password');
  const type = passwordInput.type === 'password' ? 'text' : 'password';
  passwordInput.type = type;
}
</script>

{% endblock %}
