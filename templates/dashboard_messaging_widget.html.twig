{# templates/dashboard/_messaging_widget.html.twig #}
<div class="card messaging-widget" style="border: none; box-shadow: 0 2px 8px rgba(26, 47, 54, 0.08); border-radius: 12px; overflow: hidden;">
    <!-- Header -->
    <div class="card-header" style="background-color: var(--cloudy-ocean); color: white; padding: 16px 20px; border: none;">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                💬 Messagerie
            </h5>
            <a href="{{ path('app_conversation_index') }}" style="color: white; text-decoration: none; font-size: 12px; border: 1px solid rgba(255,255,255,0.3); padding: 4px 12px; border-radius: 20px; transition: all var(--transition-base);">
                Voir tout
            </a>
        </div>
    </div>

    <!-- Body -->
    <div class="card-body p-0">
        {% if recentConversations is not empty %}
            <!-- Conversations List -->
            <div class="conversations-list">
                {% for conversation in recentConversations %}
                    {% set lastMessage = conversation.message | last %}
                    <a href="{{ path('app_conversation_show', {'id': conversation.id}) }}" 
                       class="conversation-item" 
                       style="display: block; padding: 12px 16px; border-bottom: 1px solid #e0d4c8; text-decoration: none; color: inherit; transition: all var(--transition-base);">
                        
                        <!-- Participants -->
                        <div style="display: flex; gap: 4px; margin-bottom: 6px; flex-wrap: wrap;">
                            {% set participants = messagingService.getOtherParticipants(conversation, app.user) %}
                            {% for participant in participants %}
                                <span style="font-size: 11px; font-weight: 600; color: white; background-color: var(--sky-shell); padding: 2px 8px; border-radius: 12px;">
                                    {{ participant.email | split('@')[0] }}
                                </span>
                            {% endfor %}
                        </div>

                        <!-- Message Preview -->
                        <div style="font-size: 13px; color: var(--dune); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                            {% if lastMessage %}
                                <strong>{{ lastMessage.user.email | split('@')[0] }}:</strong> {{ lastMessage.content[:50] }}{% if lastMessage.content | length > 50 %}...{% endif %}
                            {% else %}
                                <em style="color: var(--sunlit-sand);">Aucun message</em>
                            {% endif %}
                        </div>

                        <!-- Time -->
                        <div style="font-size: 11px; color: var(--sunlit-sand); margin-top: 4px;">
                            {{ (conversation.updatedAt ?: conversation.createdAt) | format_ago }}
                        </div>
                    </a>
                {% endfor %}
            </div>

            <!-- Stats Footer -->
            <div style="background-color: var(--cream); padding: 12px 16px; display: flex; justify-content: space-around; border-top: 1px solid #e0d4c8;">
                <div style="text-align: center;">
                    <div style="font-size: 20px; font-weight: bold; color: var(--deep-marine);">
                        {{ messagingStats.totalConversations }}
                    </div>
                    <div style="font-size: 11px; color: var(--dune);">Conversations</div>
                </div>
                <div style="width: 1px; background-color: #e0d4c8;"></div>
                <div style="text-align: center;">
                    <div style="font-size: 20px; font-weight: bold; color: var(--deep-marine);">
                        {{ messagingStats.todayMessages }}
                    </div>
                    <div style="font-size: 11px; color: var(--dune);">Messages (auj.)</div>
                </div>
                <div style="width: 1px; background-color: #e0d4c8;"></div>
                <div style="text-align: center;">
                    <div style="font-size: 20px; font-weight: bold; color: var(--deep-marine);">
                        {{ messagingStats.activeConversations }}
                    </div>
                    <div style="font-size: 11px; color: var(--dune);">Actives (7j)</div>
                </div>
            </div>
        {% else %}
            <!-- Empty State -->
            <div style="padding: 40px 20px; text-align: center; background-color: var(--cream);">
                <div style="font-size: 40px; margin-bottom: 12px;">💭</div>
                <p style="color: var(--dune); margin: 0; font-size: 14px;">
                    Aucune conversation pour le moment
                </p>
                <a href="{{ path('app_conversation_new') }}" style="display: inline-block; margin-top: 12px; background-color: var(--cloudy-ocean); color: white; padding: 8px 16px; border-radius: 6px; text-decoration: none; font-size: 12px; transition: background-color var(--transition-base);">
                    Créer une conversation
                </a>
            </div>
        {% endif %}
    </div>
</div>

<style>
.messaging-widget {
    height: 100%;
    display: flex;
    flex-direction: column;
}

.card-body {
    flex-grow: 1;
    overflow-y: auto;
}

.conversation-item:hover {
    background-color: var(--cream);
}

.conversations-list {
    max-height: 400px;
    overflow-y: auto;
}

@media (prefers-color-scheme: dark) {
    .messaging-widget {
        background-color: var(--cream-dark);
        border-color: var(--dune);
    }

    .conversation-item:hover {
        background-color: rgba(255, 255, 255, 0.05);
    }

    .conversations-list {
        border-color: var(--dune);
    }
}

@media (max-width: 768px) {
    .conversations-list {
        max-height: 300px;
    }
}
</style>
