{% extends 'base.html.twig' %}

{% block title %}Demande de réinitialisation de mot de passe{% endblock %}

{% block body %}

<div class="login-container mt-5">
  <div class="login-card">
    
    <div class="login-header">
      <div class="d-flex justify-content-center mb-2"><a href="{{ path('app_home') }}"><img class="logo" src="{{asset('images/logo.png')}}" alt=""></a></div>
      <h1>Changez votre mot de passe</h1>

    </div>

    <div class="login-body">
    <section>
        
        {{ form_start(passForm) }}

{{ form_widget(passForm) }}

<button type="submit" class="btn-submit" >Valider</button>

{{ form_end(passForm) }}

    </section>
        </div>

  </div>
</div>

<script>
function togglePassword() {
  const passwordInput = document.getElementById('password');
  const type = passwordInput.type === 'password' ? 'text' : 'password';
  passwordInput.type = type;
}
</script>
{% endblock %}
