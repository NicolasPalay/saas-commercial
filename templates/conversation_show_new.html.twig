{% extends 'base.html.twig' %}

{% block title %}{{ conversation.id | default('Conversation') }}{% endblock %}

{% block body %}
<div class="container-fluid h-100 d-flex flex-column" style="max-width: 1200px; margin: 0 auto;">
    
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center p-4" style="border-bottom: 1px solid #e0d4c8; background-color: white;">
        <div>
            <h2 class="mb-2" style="color: var(--deep-marine); font-family: 'Cormorant Garamond', serif;">
                Conversation
            </h2>
            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                {% for user in conversation.users %}
                    <span class="badge" style="background-color: var(--sky-shell); color: white; padding: 4px 12px; border-radius: 20px; font-size: 12px;">
                        {{ user.email }}
                    </span>
                {% endfor %}
            </div>
        </div>
        <a href="{{ path('app_conversation_index') }}" class="btn" style="background-color: transparent; color: var(--cloudy-ocean); border: 1px solid var(--cloudy-ocean); padding: 10px 20px; border-radius: 8px; text-decoration: none;">
            ← Retour
        </a>
    </div>

    <!-- Messages Container -->
    <section 
        class="flex-grow-1 overflow-y-auto p-4"
        id="messages-container"
        style="background-color: var(--cream, #faf5f0);"
        hx-ext="sse"
        sse-connect="{{ mercure(topicUrl) }}"
        sse-swap="message"
    >
        {% include 'message/_list.html.twig' %}
    </section>

    <!-- Input Area -->
    <div class="p-4" style="background-color: white; border-top: 1px solid #e0d4c8;">
        <form 
            hx-post="{{ path('message.create') }}" 
            hx-headers='{"Content-Type": "application/json"}'
            hx-encoding="json"
            hx-swap="none"
            class="d-flex gap-2"
        >
            <input
                type="text"
                name="content"
                placeholder="Votre message..."
                required
                class="form-control flex-grow-1"
                style="border: 1px solid #e0d4c8; border-radius: 8px; padding: 12px 16px; font-family: 'Raleway', sans-serif;"
                autocomplete="off"
            />
            
            <input
                type="hidden"
                name="conversationId"
                value="{{ conversation.id }}"
            />
            
            <button
                type="submit"
                class="btn"
                style="background-color: var(--cloudy-ocean); color: white; padding: 12px 24px; border-radius: 8px; border: none; cursor: pointer; transition: background-color var(--transition-base);"
            >
                📤 Envoyer
            </button>
        </form>
    </div>
</div>

<style>
#messages-container {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.message-item {
    max-width: 70%;
    padding: 12px 16px;
    border-radius: 12px;
    word-wrap: break-word;
    font-family: 'Raleway', sans-serif;
    font-size: 14px;
    line-height: 1.5;
    animation: slideIn 0.3s ease-out;
}

.message-item.sent {
    align-self: flex-end;
    background-color: var(--cloudy-ocean);
    color: white;
    border-bottom-right-radius: 4px;
}

.message-item.received {
    align-self: flex-start;
    background-color: white;
    color: var(--deep-marine);
    border: 1px solid #e0d4c8;
    border-bottom-left-radius: 4px;
}

.message-time {
    font-size: 12px;
    margin-top: 4px;
    opacity: 0.7;
}

.message-author {
    font-weight: 600;
    margin-bottom: 4px;
    font-size: 13px;
}

@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@media (max-width: 768px) {
    .message-item {
        max-width: 90%;
    }
}

@media (prefers-color-scheme: dark) {
    section {
        background-color: var(--cream-dark) !important;
    }

    .message-item.received {
        background-color: var(--cream-dark);
        color: var(--white);
        border-color: var(--dune);
    }
}

.form-control {
    transition: all var(--transition-base);
}

.form-control:focus {
    outline: none;
    border-color: var(--cloudy-ocean);
    box-shadow: 0 0 0 3px rgba(74, 122, 138, 0.1);
}

button:hover {
    background-color: var(--deep-marine) !important;
}
</style>

{% endblock %}

{% block javascripts %}
<script>
const messagesContainer = document.querySelector('#messages-container');
const userId = '{{ app.user.id }}';

// Auto-scroll to bottom on new message
function scrollToBottom() {
    setTimeout(() => {
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }, 100);
}

// Initial scroll
scrollToBottom();

// Observe for new messages
const observer = new MutationObserver(() => scrollToBottom());
observer.observe(messagesContainer, { childList: true });

// Handle form submission (clear input after send)
document.querySelector('form').addEventListener('htmx:afterSwap', function() {
    this.querySelector('input[name="content"]').value = '';
});
</script>
{% endblock %}
