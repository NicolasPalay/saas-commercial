{{ form_start(form) }}

<div class="card-ocean mb-4">
  <div class="card-body">

    <div class="row g-3">
        {{ form_row(form.reference) }}
        {{ form_row(form.name) }}
    <div class="mb-3 d-flex gap-5 flex-wrap">
        {{ form_row(form.price) }}
        {{ form_row(form.costPrice) }}

        <div>
        <label class="form-label fw-semibold">🧾 Taxe</label>
  
        <div class="d-flex gap-2 flex-wrap justify-content- last:between">
            {% for child in form.taxe %}
                <label class="taxe-option">
                    {{ form_widget(child, { attr: { class: 'd-none' } }) }}

                    <span class="taxe-card  py-1">
                        {{ child.vars.label }}
                    </span>
                </label>
            {% endfor %}
        </div>

        {{ form_errors(form.taxe) }}
    </div>
    </div>
        
<div class="mb-3 d-flex gap-5 flex-wrap">
    <div>
    <label class="form-label fw-semibold">🧾 Categorie</label>
         <div class="d-flex gap-2 flex-wrap">
        {% for child in form.category %}
            <label class="taxe-option">
                {{ form_widget(child, { attr: { class: 'd-none' } }) }}

                <span class="taxe-card py-1">
                    {{ child.vars.label }}
                </span>
            </label>
        {% endfor %}
   
            {{ form_errors(form.taxe) }}
            </div>
     </div>
        {{ form_row(form.stock) }}
        {{ form_row(form.barcode) }}
</div>
        
  
       <label class="btn-ocean-sm label-image">
    📷 
    {{ form_widget(form.image, {
        attr: {
            class: 'd-none',
            onchange: 'this.nextElementSibling.innerText = this.files[0]?.name || "Choisir une image"'
        }
    }) }}
    <span class="ms-2">Choisir une image</span>
</label>


    <div class="row g-3 mt-3 justify-content-center">

        <div class="col-md-2">
            <div class="form-check form-switch">
                {{ form_widget(form.isActive, { attr: { class: 'form-check-input' } }) }}
                {{ form_label(form.isActive, 'Produit actif', { label_attr: { class: 'form-check-label' } }) }}
            </div>
        </div>

        <div class="col-md-2">
            <div class="form-check form-switch">
                {{ form_widget(form.isService, { attr: { class: 'form-check-input' } }) }}
                {{ form_label(form.isService, '🛠️ Service', { label_attr: { class: 'form-check-label' } }) }}
            </div>
        </div>

    </div>

    {{ form_rest(form) }}

    <div class="d-flex justify-content-center pt-3">
        <button class="btn-ocean btn-ocean-secondary btn-ocean-sm">Enregistrer</button>
    </div>

  </div>
</div>

{{ form_end(form) }}
