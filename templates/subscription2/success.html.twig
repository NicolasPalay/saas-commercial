{% extends 'base.html.twig' %}

{% block title %}Abonnement activé{% endblock %}

{% block body %}
<div class="container py-5 text-center">
    <div class="mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="text-success" viewBox="0 0 16 16">
            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
        </svg>
    </div>
    <h1 class="h3 mb-3">Paiement confirmé !</h1>
    <p class="text-muted mb-4">
        Votre abonnement est en cours d'activation. Vous recevrez un email de confirmation d'ici quelques instants.
    </p>
    <a href="{{ path('app_dashboard') }}" class="btn btn-primary">
        Retour au tableau de bord
    </a>
</div>
{% endblock %}
