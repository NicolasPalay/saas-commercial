<form method="post" action="{{ path('app_devis_details_delete', {uuid: devis_detail.devis.company.uuid, reference: devis_detail.devis.reference, id: devis_detail.id}) }}" onsubmit="return confirm('Voulez-vous supprimer cette ligne ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ devis_detail.id) }}">
    <button class="mx-3">
        <i class="bi bi-x-circle"></i>
    </button>
</form>
