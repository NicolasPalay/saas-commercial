<form method="post" action="{{ path('app_devis_details_delete', {'uuid': devis_detail.devis.company.uuid, 'reference': devis_detail.devis.reference, 'id': devis_detail.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ devis_detail.id) }}">
    <button class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
</form>
