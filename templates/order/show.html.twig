{% extends 'base.html.twig' %}

{% block title %}Order{% endblock %}

{% block body %}
    <h1>Order</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ order.id }}</td>
            </tr>
            <tr>
                <th>Total</th>
                <td>{{ order.total }}</td>
            </tr>
            <tr>
                <th>Taxe</th>
                <td>{{ order.taxe }}</td>
            </tr>
            <tr>
                <th>TotalTTC</th>
                <td>{{ order.totalTTC }}</td>
            </tr>
            <tr>
                <th>DeliveryStreet</th>
                <td>{{ order.deliveryStreet }}</td>
            </tr>
            <tr>
                <th>DeliveryStreet2</th>
                <td>{{ order.deliveryStreet2 }}</td>
            </tr>
            <tr>
                <th>DeliveryPostalCode</th>
                <td>{{ order.deliveryPostalCode }}</td>
            </tr>
            <tr>
                <th>DeliveryCity</th>
                <td>{{ order.deliveryCity }}</td>
            </tr>
            <tr>
                <th>DeliveryLabel</th>
                <td>{{ order.deliveryLabel }}</td>
            </tr>
            <tr>
                <th>DeliveryPhone</th>
                <td>{{ order.deliveryPhone }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ order.createdAt ? order.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_order_index') }}">back to list</a>

    <a href="{{ path('app_order_edit', {'id': order.id}) }}">edit</a>

    {{ include('order/_delete_form.html.twig') }}
{% endblock %}
