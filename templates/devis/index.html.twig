{# templates/devis/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Liste des Devis{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('css/shoreline-haze.css') }}">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

{% endblock %}

{% block body %}
<main class="d-flex w-100 ">
{% include('_includes/aside.html.twig') %}
<div class="w-100 mx-4">
    
   {# Page Header #}
  <div class="page-header">
    <div class="breadcrumb-ocean">
      <a href="{{ path('app_dashboard') }}">Dashboard</a>
      <span>›</span>
      <span style="color: var(--white);">Devis</span>
    </div>
    <h1><i class="bi bi-receipt"></i> Liste des Devis</h1>
    <p>Gérez et suivez toutes vos factures clients</p>
  </div>
  <section class="row g-3 mb-4">
    <article class="col-md-6 col-12">
        <div class="w-100 new-invoice"  style="color: var(--white);">
            <h2 class="h4">Nouvelle Devis</h2>
            {{ include('devis/_form.html.twig') }}
        </div>
    </article>
    <article class="col-md-6 col-12 d-flex flex-column justify-content-between">
        <div class="col-12">
            <div class="kpi-card">
                <p class="label">Total Devis</p>
                <h2 class="value">{{ devis|length }}</h2>
            </div>
        </div>
        <div class="col-12">
      <div class="kpi-card" style="border-left-color: var(--cloudy-ocean);">
        <p class="label">Total TTC</p>
        <h2 class="value" style="color: var(--cloudy-ocean); font-size: 1.5rem;">
          {% set total = 0 %}
          {% for devi in devis %}
            {% set total = total + devi.totalTtc %}
          {% endfor %}
          {{ total|number_format(0, ',', ' ') }} €
        </h2>
      </div>
    </div>
    </article>
</section>

  {# Composant Devis #}
  <twig:DevisComponent :entity='entity' :headers='headers' :entityText='entityText' />

</div>
</main>
<script>
  // Gestion du modal
  document.querySelectorAll('.openModal').forEach(btn => {
    btn.addEventListener('click', () => {
      const modal = document.getElementById('modal');
      modal.classList.add('show');
      modal.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="{{ asset('assets/js/modal.js') }}"></script>
{% endblock %}
