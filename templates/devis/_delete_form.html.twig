<form method="post" action="{{ path('app_devis_delete', {uuid: devi.company.uuid, reference: devi.reference}) }}"
      onsubmit="return confirm('Supprimer ce devis ?')">
  <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ devi.id) }}">
  <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-trash"></i> Supprimer</button>
</form>
