{% extends 'base.html.twig' %}

{% block title %}Nouveau client{% endblock %}

{% block body %}
<main class="d-flex w-100 ">
{% include('_includes/aside.html.twig') %}
<div class="w-100 mx-4">
    <div class="login-card">
        
        <div class="login-header">
            <div class="d-flex justify-content-center mb-2"><a href="{{ path('app_home') }}"><img class="logo" src="{{asset('images/logo.png')}}" alt=""></a></div>
                 <h1 class="mb-4"><i class="bi bi-people"></i> Modification du client {{ client.raisonSocial }} et son adresse principale</h1>
                    <a  class="btn-ocean btn-ocean-secondary btn-ocean-sm" href="{{ path('app_address_new', {id: client.id}) }}">Ajouter une adresse</a>
                    <a  class="btn-ocean btn-ocean-secondary btn-ocean-sm" href="{{ path('app_address_index', {id: client.id}) }}">Voir toutes les adresses</a>
            </div>

            <div class="login-body">
                <section>
                    {{ include('client/_form.html.twig', {'button_label': 'Mettre à jour',}) }}
                </section>
            </div>    
        </div>
    </div>

  </div>
</div>


</div>    
</main>
{% endblock %}