{% extends 'base.html.twig' %}

{% block title %}Messagerie - Conversations{% endblock %}

{% block body %}
<div class="container mt-5">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3" style="color: var(--deep-marine); font-family: 'Cormorant Garamond', serif;">
            💬 Messagerie
        </h1>
        <a href="{{ path('app_conversation_new') }}" class="btn" style="background-color: var(--cloudy-ocean); color: white; padding: 10px 20px; border-radius: 8px; text-decoration: none; transition: background-color var(--transition-base);">
            + Nouvelle conversation
        </a>
    </div>

    <!-- List of Conversations -->
    <div class="row">
        {% if conversations is not empty %}
            {% for conversation in conversations %}
            <div class="col-12 mb-3">
                <a href="{{ path('app_conversation_show', {'id': conversation.id}) }}" style="text-decoration: none; color: inherit;">
                    <div class="card conversation-card" style="border-left: 4px solid var(--cloudy-ocean); transition: all var(--transition-base);">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <!-- Left: Participants & Preview -->
                            <div class="flex-grow-1">
                                <!-- Participants -->
                                <div style="display: flex; gap: 8px; margin-bottom: 8px; flex-wrap: wrap;">
                                    {% for user in conversation.users %}
                                        <span class="badge" style="background-color: var(--sky-shell); color: white; padding: 4px 12px; border-radius: 20px; font-size: 12px;">
                                            {{ user.email | split('@')[0] }}
                                        </span>
                                    {% endfor %}
                                </div>
                                
                                <!-- Last Message Preview -->
                                {% if conversation.message | length > 0 %}
                                    {% set lastMessage = conversation.message | last %}
                                    <p style="margin: 0; font-size: 14px; color: var(--dune); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                        <strong>{{ lastMessage.user.email | split('@')[0] }}:</strong> {{ lastMessage.content[:60] }}{% if lastMessage.content | length > 60 %}...{% endif %}
                                    </p>
                                {% else %}
                                    <p style="margin: 0; font-size: 14px; color: var(--sunlit-sand);">Aucun message pour l'instant</p>
                                {% endif %}
                            </div>

                            <!-- Right: Date & Message Count -->
                            <div style="text-align: right; min-width: 150px;">
                                <div style="font-size: 12px; color: var(--dune);">
                                    {{ conversation.updatedAt ? conversation.updatedAt | date('d/m/Y H:i') : conversation.createdAt | date('d/m/Y H:i') }}
                                </div>
                                <span class="badge" style="background-color: var(--cloudy-ocean); color: white; margin-top: 4px;">
                                    {{ conversation.message | length }} message{{ conversation.message | length > 1 ? 's' : '' }}
                                </span>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
            {% endfor %}
        {% else %}
            <!-- Empty State -->
            <div class="col-12">
                <div class="card" style="background-color: var(--cream); border: none; padding: 60px 40px; text-align: center;">
                    <div style="font-size: 48px; margin-bottom: 20px;">💭</div>
                    <h3 style="color: var(--deep-marine); margin-bottom: 10px;">Aucune conversation</h3>
                    <p style="color: var(--dune); margin-bottom: 20px;">Commencez une nouvelle conversation pour discuter avec vos collaborateurs.</p>
                    <a href="{{ path('app_conversation_new') }}" class="btn" style="background-color: var(--cloudy-ocean); color: white; padding: 12px 30px; border-radius: 8px; text-decoration: none; display: inline-block;">
                        Créer une conversation
                    </a>
                </div>
            </div>
        {% endif %}
    </div>
</div>

<style>
.conversation-card {
    background-color: white;
    border: 1px solid #e0d4c8;
    border-radius: 8px;
    cursor: pointer;
}

.conversation-card:hover {
    box-shadow: 0 4px 12px rgba(74, 122, 138, 0.1);
    border-left-color: var(--deep-marine);
    transform: translateX(4px);
}

@media (prefers-color-scheme: dark) {
    .conversation-card {
        background-color: var(--cream-dark);
        border-color: var(--dune);
    }
}
</style>
{% endblock %}
