<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Devis {{ devis.reference }}</title>

<style>
@page {
  margin: 130px 40px 80px 40px;
}

body {
  font-family: DejaVu Sans, Arial, sans-serif;
  font-size: 10pt;
  color: #2c3e50;
}

/* HEADER */
.header {
 position: relative;
  top: -120px;
  left: 0;
  right: 0;
  height: 100px;
  border-bottom: 2px solid #e5e5e5;
}

.header table {
  width: 100%;
}

.company-name {
  font-size: 16pt;
  font-weight: bold;
}

.company-info {
  font-size: 9pt;
}

.company-logo {
  max-height: 60px;
  margin-bottom: 5px;
}

.title {
  text-align: right;
}

.title h1 {
  margin: 0;
  font-size: 20pt;
}

/* FOOTER */
.footer {
  position: fixed;
  bottom: -60px;
  left: 0;
  right: 0;
  height: 50px;
  border-top: 1px solid #e5e5e5;
  text-align: center;
  font-size: 8pt;
  color: #777;
}

/* ADDRESSES */
.addresses {
  margin-bottom: 20px;
}

.addresses table {
  width: 100%;
}

.box {
  padding: 10px;
  background: #f8f9fa;
  border-left: 4px solid #3498db;
}

.box-title {
  font-size: 8pt;
  text-transform: uppercase;
  margin-bottom: 5px;
  color: #7f8c8d;
}

/* META */
.meta {
  margin: 20px 0;
}

.meta table {
  width: 100%;
}

.meta-label {
  font-size: 8pt;
  text-transform: uppercase;
  color: #7f8c8d;
}

.meta-value {
  font-size: 10pt;
  font-weight: bold;
}

/* TABLE */
.items table {
  width: 100%;
  border-collapse: collapse;
}

.items thead {
  display: table-header-group;
  background: #ecf0f1;
}

.items th {
  padding: 8px;
  font-size: 8pt;
  text-transform: uppercase;
  border-bottom: 2px solid #bdc3c7;
}

.items td {
  padding: 6px;
  border-bottom: 1px solid #ecf0f1;
}

.items tr {
  page-break-inside: avoid;
}

.r { text-align: right; }
.c { text-align: center; }

.items td.r {
  font-family: DejaVu Sans, monospace;
  font-weight: bold;
}

/* TOTALS */
.totals {
  margin-top: 20px;
}

.totals table {
  width: 45%;
  margin-left: auto;
  border-collapse: collapse;
  page-break-inside: avoid;
}

.totals td {
  padding: 8px;
}

.total-final {
  background: #2c3e50;
  color: white;
  font-weight: bold;
}


</style>
</head>

<body>

<!-- HEADER -->
<div class="header">
  <table>
    <tr>
      <td>
        {% if devis.company.urlLogo %}
          <img src="{{ absolute_url(asset('uploads/' ~ devis.company.id ~ '/' ~ devis.company.urlLogo)) }}"
               class="company-logo">
        {% endif %}
        <div class="company-name">{{ devis.company.name }}</div>
        <div>
          {{ devis.company.street }}<br>
          {{ devis.company.street2 }}<br>
          {{ devis.company.codePostal }} {{ devis.company.ville }}<br>
           {% if devis.company.phone %}Téléphone de l'agence : {{ devis.company.phone }}{% endif %}
          {% if devis.user.phone %}Ligne directe : {{ devis.user.phone }}{% endif %}

        </div>
      </td>
      <td class="devis-title">
        <h1>DEVIS</h1>
        N° {{ devis.reference }} - {{ devis.createdAt|date('d/m/Y') }}
      </td>
    </tr>
  </table>
</div>



<!-- ADDRESSES -->
<div class="addresses">
  <table>
    <tr>
      <td width="48%">
        <div class="box">
          <div class="box-title">Facturation</div>
          <strong>{{ devis.client.raisonSocial }}</strong><br>
          {{ devis.client.address[0].nameStreet }}<br>
          {{ devis.client.address[0].codePostal }} {{ devis.client.address[0].ville }}
        </div>
      </td>
      <td width="4%"></td>
      <td width="48%">
        <div class="box">
          <div class="box-title">Livraison</div>
          <strong>{{ devis.client.raisonSocial }}</strong><br>
          {{ devis.deliveryStreet ?? devis.client.address[0].nameStreet }}<br>
          {{ devis.deliveryPostalCode ?? devis.client.address[0].codePostal }}
          {{ devis.deliveryCity ?? devis.client.address[0].ville }}
        </div>
      </td>
    </tr>
  </table>
</div>

<!-- META -->
<div class="meta">
  <table>
    <tr>
      <td>
        <div class="meta-label">Date du devis</div>
        <div class="meta-value">{{ devis.createdAt|date('d/m/Y') }}</div>
      </td>
      <td>
        <div class="meta-label">Valable jusqu'au</div>
        <div class="meta-value">{{ devis.createdAt|date_modify('+3 months')|date('d/m/Y') }}</div>
      </td>
      <td>
        <div class="meta-label">Conditions de paiement</div>
        <div class="meta-value">
          {{ devis.paymentTerms|default('30 jours fin de mois') }}
        </div>
      </td>
    </tr>
  </table>
</div>

<!-- ITEMS -->
<div class="items">
  <table>
      <thead>
        <tr>
          <th style="width:7%">Réf</th>
          <th style="width:39%">Désignation</th>
          <th class="c" style="width:7%">Qté</th>
          <th class="r" style="width:13%">PU HT</th>
          <th class="c" style="width:9%">Remise</th>
          <th class="r" style="width:15%">Total HT</th>
          <th class="r" style="width:10%">TVA</th>
        </tr>
      </thead>
    <tbody>
      {% for line in devis.devisDetails %}
      {% set taxeRate = line.taxe ? line.taxe.rate : 20 %}
      <tr>
        <td>{{ line.product.reference }}</td>
        <td>{{ line.label }}</td>
        <td class="c">{{ line.quantity }}</td>
        <td class="r">{{ line.price|number_format(2, ',', ' ') }} €</td>
        <td class="c">
          {% if line.reduce > 0 %}
            {{ line.reduce|number_format(2, ',', ' ') }}%
          {% else %}
            —
          {% endif %}
        </td>
        <td class="r">{{ line.total|number_format(2, ',', ' ') }} €</td>
        <td class="r">{{ taxeRate }}%</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

<!-- TOTALS -->
<div class="totals">
  <table>
    <tr>
      <td>Total HT</td>
      <td class="r">{{ devis.total|number_format(2, ',', ' ') }} €</td>
    </tr>
    <tr>
      <td>TVA</td>
      <td class="r">{{ devis.taxe|number_format(2, ',', ' ') }} €</td>
    </tr>
    <tr class="total-final">
      <td>Total TTC</td>
      <td class="r">{{ devis.totalTTC|number_format(2, ',', ' ') }} €</td>
    </tr>
  </table>
</div>
<!-- FOOTER -->
<div class="footer">
  {{ devis.company.name }} — devis n°{{ devis.reference }}
</div>
</body>
</html>