{% extends 'base.html.twig' %}

{% block title %}OrderDetail index{% endblock %}

{% block body %}
    <h1>OrderDetail index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Label</th>
                <th>Price</th>
                <th>Reduce</th>
                <th>Quantity</th>
                <th>Total</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for order_detail in order_details %}
            <tr>
                <td>{{ order_detail.id }}</td>
                <td>{{ order_detail.label }}</td>
                <td>{{ order_detail.price }}</td>
                <td>{{ order_detail.reduce }}</td>
                <td>{{ order_detail.quantity }}</td>
                <td>{{ order_detail.total }}</td>
                <td>
                    <a href="{{ path('app_order_detail_show', {'id': order_detail.id}) }}">show</a>
                    <a href="{{ path('app_order_detail_edit', {'id': order_detail.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_order_detail_new') }}">Create new</a>
{% endblock %}
