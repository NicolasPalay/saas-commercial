<form method="post" action="{{ path('app_order_detail_delete', {'uuid': order_detail.commande.company.uuid, 'reference': order_detail.commande.reference, 'id': order_detail.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ order_detail.id) }}">
    <button class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
</form>
