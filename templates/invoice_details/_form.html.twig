<div class="card-ocean">
  {# Header avec infos du devis #}
  <div class="card-ocean-header" style="padding: 32px 40px;">
    <h1 style="color: var(--white); font-size: 24px; margin-bottom: 8px; text-align: center;">
        Commande n°{{ invoice.reference }}
    </h1>
     <div class="divider"></div>
    <header class="d-flex justify-content-center gap-5">
      <div class="border px-4 py-2 rounded-3 text-right">
        <a href="{{ path('app_invoice_edit', {'id': invoice.id}) }}" class="btn-ocean btn-ocean-secondary btn-ocean-sm">
            <i class="bi bi-pencil"></i> Modifier l'adresse
        </a>
      <h1 class="my-4 h4">Adresse de Livraison</h1>
      <hr>
        <h2 class="mb-25 h4 adresse-devis">
          <a href="{{ path('app_invoice_edit', {'id': invoice.id}) }}"  class="mb-25 h4">
            {{ invoice.raisonSocial }}
          </a>
        </h2>
       
          
              <div>

              {% if invoice.nameStreet %}{{ invoice.nameStreet }}<br>{% endif %}
              {% if invoice.nameStreet2 %}{{ invoice.nameStreet2 }}<br>{% endif %}
                {{ invoice.codePostal }} {{ invoice.ville }}<br>
                {% if invoice.email %}<br>{{ invoice.email }}<br>{% endif %}

              </div>
           
      </div>
      
        {# Bouton retour vers l'édition du devis #}
      <div class="action-header">

       
        <a href="{{ path('app_invoice_output_pdf', {'id': invoice.id}) }}" class="btn-ocean btn-ocean-secondary btn-ocean-sm" target="_blank">
            <i class="bi bi-file-pdf"></i> enregistrer en PDF
        </a>
        <a href="{{ path('app_invoice_send', {'id': invoice.id}) }}" class="btn-ocean btn-ocean-secondary btn-ocean-sm">
          <i class="bi bi-file-pdf"></i> envoyer par email
        </a>
      </div>
    </header>
  </div>
  <div class="card-ocean-body">
 
    {# Tableau des lignes de invoice #}
    <div class="table-card mb-4">
      <div class="table-responsive">
        <table class="table-ocean">
          <thead>
            <tr>
              <th>Réf. Prod</th>
              <th>Nom du Produit</th>
              <th>Qté</th>
              <th>Prix Unit</th>
              <th>Remise</th>
              <th>Total</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {% for invoiceLine in invoice.invoiceDetails %}
              <tr>
                <td>
                  <a href="{{ path('app_invoice_details_edit', {'id': invoiceLine.id}) }}">
                    {{ invoiceLine.product.reference }}
                  </a>
                </td>
                <td>
                  <a href="{{ path('app_invoice_details_edit', {'id': invoiceLine.id}) }}">
                    {{ invoiceLine.label }}
                  </a>
                </td>
                <td>{{ invoiceLine.quantity }}</td>
                <td>{{ invoiceLine.price | number_format(2, ',', ' ') }} €</td>
                <td>{{ invoiceLine.reduce | number_format(2, ',', ' ') }} %</td>
                <td><strong>{{ invoiceLine.total | number_format(2, ',', ' ') }} €</strong></td>
                <td>
                  {{ include('invoice_details/_delete_form.html.twig', { invoice_detail: invoiceLine }) }}
                </td>
              </tr>
            {% else %}
              <tr>
                <td colspan="7" style="text-align: center; padding: 40px; color: var(--dune);">
                  <i class="bi bi-inbox" style="font-size: 48px; display: block; margin-bottom: 12px; opacity: 0.5;"></i>
                  Aucune ligne de invoice
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

    

       {# Formulaire d'ajout/édition #}
    <div id="addLine" class="bg-light p-4 form-edit-detail-devis editAbsolute" style="border-radius: var(--radius-lg); border: 1.5px solid var(--sky-shell);">
      </h3>
      {{ form_start(form, {
          attr: { 'data-devis-detail': '1' }
      }) }}
        {{ form_widget(form) }}
        <button class="btn-ocean btn-ocean-secondary btn-ocean-sm" type="submit"
    >{{ button_label|default('Sélectionnez') }}</button>
    {{ form_end(form) }}
    </div>
<div class="divider"></div>
  </div>
</div>
