{% extends 'base.html.twig' %}

{% block title %}Edit InDetails{% endblock %}
{% block class %}devis_details_edit{% endblock %}
{% block body %}
<div class="page-container">
    {# Contenu principal #}
  {{ include('invoice_details/_form.html.twig', {
    'button_label': 'Mettre à jour',
    'invoice': invoice_detail.invoice
  }) }}

  {# Actions #}
  <div class="d-flex gap-3 mt-4">
    <a href="{{ path('app_invoice_details_new', {uuid: invoice_detail.invoice.company.uuid, reference: invoice_detail.invoice.reference}) }}" class="btn-ocean btn-ocean-secondary">
      <i class="bi bi-arrow-left"></i> Retour à la liste
    </a>
    {{ include('invoice_details/_delete_form.html.twig') }}
  </div>

</div>
{% endblock %}
