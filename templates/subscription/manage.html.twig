{% extends 'base.html.twig' %}

{% block title %}Mon abonnement{% endblock %}

{% block body %}
<div class="container py-5">
    <h1 class="fw-bold mb-4">Mon abonnement</h1>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('warning') %}
        <div class="alert alert-warning">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('danger') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}

    {% if subscription %}
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-success text-white d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill"></i>
                <span class="fw-semibold">Abonnement actif</span>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <p class="text-muted mb-1 small">Plan</p>
                        <p class="fw-semibold fs-5">{{ subscription.plan.name }}</p>
                    </div>
                    <div class="col-md-6">
                        <p class="text-muted mb-1 small">Montant</p>
                        <p class="fw-semibold fs-5">{{ subscription.montant }} € / mois</p>
                    </div>
                    <div class="col-md-6">
                        <p class="text-muted mb-1 small">Date de souscription</p>
                        <p class="fw-semibold">{{ subscription.createdAt|date('d/m/Y') }}</p>
                    </div>
                    <div class="col-md-6">
                        <p class="text-muted mb-1 small">Statut</p>
                        <span class="badge bg-success fs-6">Actif</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-3">
            <a href="{{ path('subscription_billing_portal') }}" class="btn btn-outline-primary">
                <i class="bi bi-credit-card me-2"></i>Gérer la facturation (portail Stripe)
            </a>

            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancelModal">
                <i class="bi bi-x-circle me-2"></i>Annuler mon abonnement
            </button>
        </div>

        {# Modal de confirmation d'annulation #}
        <div class="modal fade" id="cancelModal" tabindex="-1" aria-labelledby="cancelModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="cancelModalLabel">Confirmer l'annulation</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p>Êtes-vous sûr de vouloir annuler votre abonnement <strong>{{ subscription.plan.name }}</strong> ?</p>
                        <p class="text-muted small">L'accès restera actif jusqu'à la fin de la période en cours.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Retour</button>
                        <form action="{{ path('subscription_cancel') }}" method="POST">
                            <input type="hidden" name="_token" value="{{ csrf_token('cancel_subscription') }}">
                            <button type="submit" class="btn btn-danger">Confirmer l'annulation</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

    {% else %}
        <div class="card shadow-sm border-0">
            <div class="card-body text-center py-5">
                <i class="bi bi-x-circle text-muted" style="font-size: 3rem;"></i>
                <h4 class="mt-3 mb-2">Aucun abonnement actif</h4>
                <p class="text-muted mb-4">Souscrivez à un plan pour accéder à toutes les fonctionnalités.</p>
                <a href="{{ path('subscription_plans') }}" class="btn btn-primary">
                    Voir les offres
                </a>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
