{% extends 'base.html.twig' %}

{% block title %}Abonnement activé{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="mb-4">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
            </div>
            <h1 class="fw-bold mb-3">Abonnement activé !</h1>
            <p class="text-muted mb-4">
                Merci pour votre souscription. Votre abonnement est maintenant actif et un email de confirmation vous a été envoyé.
            </p>
            <div class="d-flex gap-3 justify-content-center">
                <a href="{{ path('subscription_manage') }}" class="btn btn-primary">
                    <i class="bi bi-gear me-2"></i>Gérer mon abonnement
                </a>
                <a href="{{ path('app_dashboard') }}" class="btn btn-outline-secondary">
                    <i class="bi bi-house me-2"></i>Tableau de bord
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
