{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}
<main class="d-flex w-100 ">
{% include('_includes/aside.html.twig') %}
<div class="w-100 mx-4">

     

    <div class="login-card">
        
        <div class="login-header">
            <div class="d-flex justify-content-center mb-2"><a href="{{ path('app_home') }}"><img class="logo" src="{{asset('images/logo.png')}}" alt=""></a></div>
                 <h1><i class="bi bi-receipt"></i> Nouvel employé</h1>

            </div>

            <div class="login-body">
                <section>
                    {{ form_start(employedForm) }}
                        {{ form_widget(employedForm) }}
                        <button class="btn-ocean btn-ocean-primary mt-3">{{ button_label|default('Créer') }}</button>
                    {{ form_end(employedForm) }}
                </section>
            </div>    
        </div>
    </div>

  </div>
</div>


</div>    
</main>
<script>
function togglePassword() {
  const passwordInput = document.getElementById('password');
  const type = passwordInput.type === 'password' ? 'text' : 'password';
  passwordInput.type = type;
}
</script>
{% endblock %}